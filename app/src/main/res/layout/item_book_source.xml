<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/novel_helper_preference_card"
    android:clipToPadding="false"
    android:elevation="1dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp"
    android:scrollbars="none">

    <View
        android:id="@+id/selection_accent"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@color/xuanjuan_gold_soft"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <io.legado.app.ui.widget.text.AccentTextView
        android:id="@+id/tv_host_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:scrollbars="none"
        android:singleLine="true"
        android:textColor="@color/xuanjuan_gold_soft"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/selection_accent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="示例域名"
        tools:visibility="visible" />

    <io.legado.app.lib.theme.view.ThemeCheckBox
        android:id="@+id/cb_book_source"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:scrollbars="none"
        android:singleLine="true"
        android:textColor="@color/primaryText"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@id/tv_js_badge"
        app:layout_constraintStart_toEndOf="@id/selection_accent"
        app:layout_constraintTop_toBottomOf="@id/tv_host_text"
        app:layout_goneMarginTop="0dp"
        tools:ignore="TouchTargetSizeCheck"
        tools:text="@string/book_source" />

    <io.legado.app.ui.widget.text.AccentTextView
        android:id="@+id/tv_js_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/novel_helper_section_outline"
        android:minHeight="20dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:singleLine="true"
        android:text="@string/js_source_badge"
        android:textColor="@color/xuanjuan_gold_soft"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cb_book_source"
        app:layout_constraintEnd_toStartOf="@id/swt_enabled"
        app:layout_constraintTop_toTopOf="@id/cb_book_source"
        tools:visibility="visible" />

    <io.legado.app.lib.theme.view.ThemeSwitch
        android:id="@+id/swt_enabled"
        android:name="@string/enable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="@id/cb_book_source"
        app:layout_constraintEnd_toStartOf="@id/iv_edit"
        app:layout_constraintTop_toTopOf="@id/cb_book_source"
        tools:ignore="TouchTargetSizeCheck" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_edit"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/edit"
        android:padding="6dp"
        android:scrollbars="none"
        android:src="@drawable/ic_edit"
        android:tint="@color/xuanjuan_gold_soft"
        app:layout_constraintBottom_toBottomOf="@id/cb_book_source"
        app:layout_constraintEnd_toStartOf="@id/iv_menu_more"
        app:layout_constraintTop_toTopOf="@id/cb_book_source" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_menu_more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_menu"
        android:padding="6dp"
        android:scrollbars="none"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/xuanjuan_gold_soft"
        app:layout_constraintBottom_toBottomOf="@id/cb_book_source"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cb_book_source" />

    <io.legado.app.ui.widget.image.CircleImageView
        android:id="@+id/iv_explore"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:scaleType="centerCrop"
        android:scrollbars="none"
        android:src="@color/xuanjuan_gold_soft"
        app:layout_constraintEnd_toEndOf="@id/iv_menu_more"
        app:layout_constraintTop_toTopOf="@id/iv_menu_more" />

    <TextView
        android:id="@+id/tv_source_url"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/tv_text_summary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/cb_book_source"
        app:layout_constraintTop_toBottomOf="@id/cb_book_source"
        tools:text="https://example.com/source" />

    <TextView
        android:id="@+id/iv_debug_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:scrollbars="none"
        android:singleLine="true"
        android:textColor="@color/tv_text_summary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_progressBar"
        app:layout_constraintStart_toStartOf="@id/tv_source_url"
        app:layout_constraintTop_toBottomOf="@id/tv_source_url"
        tools:text="@string/debug_hint"
        tools:visibility="visible" />

    <io.legado.app.lib.theme.view.ThemeProgressBar
        android:id="@+id/iv_progressBar"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:animationResolution="1000"
        android:indeterminate="true"
        android:indeterminateBehavior="repeat"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iv_debug_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_debug_text"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
