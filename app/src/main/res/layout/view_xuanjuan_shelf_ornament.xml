<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="22dp"
    android:gravity="center"
    android:importantForAccessibility="no"
    android:orientation="horizontal"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:background="@drawable/xuanjuan_ornament_line" />

    <View
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/xuanjuan_ornament_diamond"
        android:rotation="45" />

    <TextView
        android:id="@+id/tv_xuanjuan_library_mark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:text="@string/xuanjuan_library_mark"
        android:textColor="@color/xuanjuan_gold_soft"
        android:textSize="11sp"
        android:textStyle="bold" />

    <View
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/xuanjuan_ornament_diamond"
        android:rotation="45" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:background="@drawable/xuanjuan_ornament_line" />

</LinearLayout>
