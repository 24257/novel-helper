<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/xuanjuan_gold_dim" />
            <stroke android:width="1dp" android:color="@color/xuanjuan_gold_soft" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/xuanjuan_surface_raised" />
            <stroke android:width="1dp" android:color="@color/xuanjuan_gold" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/xuanjuan_surface_raised" />
            <stroke android:width="1dp" android:color="@color/xuanjuan_gold_dim" />
        </shape>
    </item>
</selector>
