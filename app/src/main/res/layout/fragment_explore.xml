<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:attachToActivity="false"
        app:contentLayout="@layout/view_search"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/xuanjuan_book_mall_title" />

    <LinearLayout
        android:id="@+id/explore_intro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/novel_helper_preference_card"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_bar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/xuanjuan_book_mall_mark"
            android:textColor="@color/xuanjuan_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/xuanjuan_book_mall_heading"
            android:textColor="@color/xuanjuan_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/xuanjuan_book_mall_summary"
            android:textColor="@color/xuanjuan_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aggregate_portal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/novel_helper_preference_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="78dp"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/explore_intro">

        <TextView
            android:id="@+id/tv_aggregate_badge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/xuanjuan_explore_chip"
            android:gravity="center"
            android:textColor="@color/xuanjuan_gold_soft"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="聚" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_aggregate_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/xuanjuan_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="玄卷聚合榜" />

            <TextView
                android:id="@+id/tv_aggregate_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/xuanjuan_text_secondary"
                android:textSize="12sp"
                tools:text="跨源热度 · 同书去重" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/xuanjuan_gold_soft" />
    </LinearLayout>

    <io.legado.app.ui.widget.recycler.RecyclerViewAtPager2
        android:id="@+id/rv_find"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/aggregate_portal"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_find_book" />

    <io.legado.app.ui.widget.recycler.scroller.FastScroller
        android:id="@+id/fast_scroller"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/fastscroll_scrollbar_margin_top"
        android:layout_marginBottom="@dimen/fastscroll_scrollbar_margin_bottom"
        app:layout_constraintTop_toTopOf="@id/rv_find"
        app:layout_constraintBottom_toBottomOf="@id/rv_find"
        app:layout_constraintEnd_toEndOf="@id/rv_find" />

    <TextView
        android:id="@+id/tv_empty_msg"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/novel_helper_state_card"
        android:gravity="center"
        android:padding="22dp"
        android:text="@string/xuanjuan_book_mall_empty"
        android:textColor="@color/xuanjuan_text_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/aggregate_portal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:text="暂时没有可用榜单" />

</androidx.constraintlayout.widget.ConstraintLayout>
